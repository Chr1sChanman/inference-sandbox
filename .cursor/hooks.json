{
    "version": 1,
    "hooks": {
      "afterFileEdit": [
        {
          "command": ".cursor/hooks/format-python.sh",
          "timeout": 20
        }
      ],
      "beforeShellExecution": [
        {
          "command": ".cursor/hooks/block-destructive.sh",
          "timeout": 5,
          "failClosed": true
        }
      ],
      "beforeMCPExecution": [
        {
          "command": ".cursor/hooks/audit-mcp.sh",
          "timeout": 5
        }
      ],
      "stop": [
        {
          "command": ".cursor/hooks/quick-tests.sh",
          "timeout": 180
        }
      ]
    }
  }